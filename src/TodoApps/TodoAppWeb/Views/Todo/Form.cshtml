@model FormViewModel
@using TodoAppWeb.Resources
@using TodoAppWeb.ViewModels.Todo
@{
    ViewData["Title"] = TodoResource.TitleForm;
}

<form asp-action="Form">
    @if (!string.IsNullOrEmpty(Model.Msg))
    {
        <div class="mb-1 text-danger">@Model.Msg</div>
    }
    <div class="form-group">
        <label asp-for="Title" class="control-label"></label>
        <input asp-for="Title" class="form-control" type="text" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="DueDt" class="control-label"></label>
        <input asp-for="DueDt" class="form-control" type="date" />
        <span asp-validation-for="DueDt" class="text-danger"></span>
    </div>
    <div class="mt-2 text-center">
        <input type="submit" value="@CmnResource.BtnRegister" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">@CmnResource.BtnCancel</a>
    </div>
</form>
